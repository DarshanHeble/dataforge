# ==============================================================================
# DATAFORGE ENVIRONMENT CONFIGURATION & CREDENTIALS
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS S3 / OBJECT STORAGE CREDENTIALS
# ------------------------------------------------------------------------------
# For Local MinIO emulation (Default):
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=dataforge-lake

# For Real AWS S3 in Cloud (Uncomment and leave S3_ENDPOINT_URL empty):
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-production-dataforge-lake-bucket

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATA WAREHOUSE CREDENTIALS
# ------------------------------------------------------------------------------
# Host port is 5433 to prevent collision with local OS postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=dataforge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 3. APACHE AIRFLOW METASTORE & WEBSERVER CREDENTIALS
# ------------------------------------------------------------------------------
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/dataforge_db
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ------------------------------------------------------------------------------
# 4. EXTERNAL REST API CONFIGURATION (OPTIONAL / MOCK)
# ------------------------------------------------------------------------------
RATES_API_KEY=
RATES_API_ENDPOINT=https://api.exchangerate-api.com/v4/latest/USD
